# Copy to .env for local development. All values shown are the defaults.

# PostgreSQL connection string used by the API and the migrate command.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/payments?sslmode=disable

# HTTP listen port.
PORT=8080

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Maximum number of retries before an event is marked failed.
MAX_RETRIES=3

# Base delay for exponential backoff (1s, 2s, 4s, ...).
RETRY_BASE_DELAY=1s

# How often an idle worker polls for pending events.
WORKER_INTERVAL=1s

# Number of concurrent worker goroutines.
WORKER_CONCURRENCY=2

# Probability [0,1] that the simulated downstream call fails.
FAILURE_RATE=0.3

# Timeout for outbound webhook HTTP requests.
WEBHOOK_TIMEOUT=5s

# Maximum webhook delivery retries.
WEBHOOK_MAX_RETRIES=5
